{
  "name": "my-qwen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "千问网站界面复刻，支持本地对话和可选的通义千问 API",
  "scripts": {
    "dev": "npm run build && node .build/scripts/dev.js",
    "start": "npm run build && node .build/src/app-server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node .build/scripts/build.js",
    "test": "npm run build && node --test .build/tests/*.test.js",
    "check:api": "npm run build && node .build/scripts/check-api.js"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "0.6.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-loader": "10.1.1",
    "copy-webpack-plugin": "14.0.0",
    "html-webpack-plugin": "5.6.8",
    "react-refresh": "0.19.0",
    "type-fest": "4.41.0",
    "typescript": "~5.9.3",
    "webpack": "5.111.1",
    "webpack-dev-server": "6.0.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
