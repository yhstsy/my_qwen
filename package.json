{
  "name": "my-qwen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "千问网站界面复刻，支持本地对话和可选的通义千问 API",
  "scripts": {
    "dev": "npm run build && node .build/dev.js",
    "start": "npm run build && node .build/app-server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node .build/build.js",
    "test": "npm run build && node --test .build/chat.test.js",
    "check:api": "npm run build && node .build/check-api.js"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  }
}
